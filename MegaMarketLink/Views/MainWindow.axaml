<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MegaMarketLink.ViewModels"
        x:DataType="vm:MainWindowVM"
        mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="768"
        x:Class="MegaMarketLink.Views.MainWindow"
        Title="MainWindow"
        Width="1024"
        Height="768">
    <Window.DataContext>
        <vm:MainWindowVM/>
    </Window.DataContext>
     <Grid ColumnDefinitions="240,*">
         
         <Border Grid.Column="0"
                 Background="#F1F2F6"
                 Padding="15">

             <Grid RowDefinitions="Auto,*,Auto">

                 <TextBlock Grid.Row="0"
                            Text="MegaMarketLink"
                            FontSize="23"
                            FontWeight="Bold"
                            Margin="0 10 0 30"/>

                 <StackPanel Grid.Row="1" Spacing="10">

                     <TextBlock Text="Категории"
                                FontWeight="Bold"
                                FontSize="16"/>

                     <Button Content="Все товары"
                             Command="{Binding ShowCatalogCommand}"/>

                     <ListBox ItemsSource="{Binding Categories}"
                              SelectedItem="{Binding SelectedCategory}"
                              Background="Transparent"
                              BorderThickness="0">

                         <ListBox.ItemTemplate>
                             <DataTemplate>
                                 <TextBlock Text="{Binding Name}"/>
                             </DataTemplate>
                         </ListBox.ItemTemplate>

                     </ListBox>

                     <Separator/>

                     <Button Content="Корзина"
                             Command="{Binding ShowCartCommand}"/>

                     <Button Content="Мои заказы"
                             Command="{Binding ShowOrdersCommand}"/>

                     <Button Content="Мой магазин"
                             Command="{Binding ShowSellerCommand}"
                             IsVisible="{Binding IsSeller}"/>

                 </StackPanel>

             </Grid>

         </Border>

        <!-- Main content -->
        <Grid Grid.Column="1"
              Background="#FFFFFF"
              Margin="25">

            <ContentControl Content="{Binding CurrentView}"/>

        </Grid>

    </Grid>
</Window>
