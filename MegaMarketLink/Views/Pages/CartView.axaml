<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MegaMarketLink.ViewModels.Pages"
             xmlns:models="clr-namespace:MegaMarketLink.Models"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="MegaMarketLink.Views.Pages.CartView"
             x:DataType="vm:CartVM">
    <Grid RowDefinitions="Auto,*,Auto"
          Margin="25">
        
        <TextBlock Grid.Row="0"
                   Text="Корзина"
                   FontSize="28"
                   FontWeight="Bold"
                   Margin="0 0 0 20"/>
        
        <TextBlock Grid.Row="1"
                   Text="Корзина пока пуста"
                   FontSize="20"
                   Foreground="#888888"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   IsVisible="{Binding IsEmpty}"/>
        
        <ScrollViewer Grid.Row="1">

            <ItemsControl ItemsSource="{Binding CartProducts}">

                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:CartProduct"
                                  x:CompileBindings="False">

                        <Border Background="#F1F2F6"
                                CornerRadius="10"
                                Padding="15"
                                Margin="0 0 0 12">

                            <Grid ColumnDefinitions="*,Auto,Auto"
                                  ColumnSpacing="20">
                                
                                <StackPanel Grid.Column="0"
                                            Spacing="6"
                                            VerticalAlignment="Center">

                                    <TextBlock Text="{Binding Name}"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               TextWrapping="Wrap"/>

                                    <TextBlock Text="{Binding Price, StringFormat='{}{0:N2} ₽ за шт.'}"
                                               Foreground="#666666"/>

                                    <TextBlock Text="{Binding TotalPrice, StringFormat='Итого: {0:N2} ₽'}"
                                               FontWeight="Bold"
                                               FontSize="16"/>

                                </StackPanel>
                                
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            Spacing="10"
                                            VerticalAlignment="Center">

                                    <Button Content="−"
                                            Width="35"
                                            Command="{Binding $parent[ItemsControl].DataContext.RemoveProductCommand}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding CanDecrease}"/>

                                    <TextBlock Text="{Binding Quantity}"
                                               FontSize="17"
                                               VerticalAlignment="Center"/>

                                    <Button Content="+"
                                            Width="35"
                                            Command="{Binding $parent[ItemsControl].DataContext.AddProductCommand}"
                                            CommandParameter="{Binding}"/>

                                </StackPanel>
                                
                                <Button Grid.Column="2"
                                        Content="Удалить"
                                        VerticalAlignment="Center"
                                        Command="{Binding $parent[ItemsControl].DataContext.DeleteProductCommand}"
                                        CommandParameter="{Binding}"/>

                            </Grid>

                        </Border>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </ScrollViewer>
        
        <Border Grid.Row="2"
                Background="#F1F2F6"
                CornerRadius="10"
                Padding="20"
                Margin="0 15 0 0">

            <Grid ColumnDefinitions="*,Auto">

                <TextBlock Text="Общая стоимость:"
                           FontSize="20"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1"
                           Text="{Binding TotalPrice, StringFormat='{}{0:N2} ₽'}"
                           FontSize="22"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

            </Grid>

        </Border>

    </Grid>
</UserControl>
