<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MegaMarketLink.App"
             xmlns:local="using:MegaMarketLink"
             xmlns:vm="using:MegaMarketLink.ViewModels.Pages"
             xmlns:pages="using:MegaMarketLink.Views.Pages"
             RequestedThemeVariant="Light">
    <Application.Styles>
        <FluentTheme />
        <Style Selector="Button">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#000"/>
            <Setter Property="Foreground" Value="#fff"/>
            <Setter Property="FontWeight" Value="500"/>
        </Style>
        <Style Selector="ComboBox, TextBox">
            <Setter Property="Width" Value="200"/>
            <Setter Property="Margin" Value="3"/>
        </Style>
    </Application.Styles>
    
    <Application.DataTemplates>

        <DataTemplate DataType="{x:Type vm:CatalogVM}">
            <pages:CatalogView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:CartVM}">
            <pages:CartView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:OrdersVM}">
            <pages:OrdersView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SellerVM}">
            <pages:SellerView/>
        </DataTemplate>

    </Application.DataTemplates>
</Application>